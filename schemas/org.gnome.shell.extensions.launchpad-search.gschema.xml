<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="launchpad-search">
  <schema id="org.gnome.shell.extensions.launchpad-search" path="/org/gnome/shell/extensions/launchpad-search/">
    <key name="toggle-launcher" type="as">
      <default><![CDATA[['<Super><Alt>space']]]></default>
      <summary>Shortcut that opens the search</summary>
    </key>
    <key name="web-search-url" type="s">
      <default>'https://www.google.com/search?q=%s'</default>
      <summary>Web search address, %s is replaced by the searched text</summary>
    </key>
    <key name="max-results" type="i">
      <range min="3" max="20"/>
      <default>8</default>
      <summary>Maximum number of results shown</summary>
    </key>
  </schema>
</schemalist>
