msgid "App"
msgstr "App"

msgid "Browse files and folders"
msgstr "Navegar por arquivos e pastas"

msgid "Calculate"
msgstr "Calcular"

msgid "Calculator"
msgstr "Calculadora"

msgid "Cancel"
msgstr "Cancelar"

msgid "Change"
msgstr "Alterar"

msgid "Command"
msgstr "Comando"

msgid "Could not open the result"
msgstr "Não foi possível abrir o resultado"

msgid "Disabled"
msgstr "Desativado"

msgid "Esc cancels. Backspace disables the shortcut."
msgstr "Esc cancela. Backspace desativa o atalho."

msgid "File"
msgstr "Arquivo"

msgid "Folder"
msgstr "Pasta"

msgid "Maximum results"
msgstr "Máximo de resultados"

msgid "Prefixes"
msgstr "Prefixos"

msgid "Press Enter to copy the result"
msgstr "Enter copia o resultado"

msgid "Press the new shortcut"
msgstr "Pressione o novo atalho"

msgid "Run in background"
msgstr "Executar em segundo plano"

msgid "Run in terminal"
msgstr "Executar no terminal"

msgid "Search"
msgstr "Busca"

msgid "Search apps, windows, files or type a calculation"
msgstr "Busque apps, janelas, arquivos ou digite uma conta"

msgid "Search the web"
msgstr "Pesquisar na web"

msgid "Search the web for “%s”"
