msgid "Shortcut"
msgstr "Atalho"

msgid "Switch to %s"
msgstr "Ir para %s"

msgid "System"
msgstr "Sistema"

msgid "Use Super, Ctrl or Alt together with another key."
msgstr "Use Super, Ctrl ou Alt junto com outra tecla."

msgid "Web"
msgstr "Web"

msgid "Web search address (%s is the searched text)"
msgstr "Endereço da busca na web (%s é o texto buscado)"

msgid "Window"
msgstr "Janela"

msgid "Add"
msgstr "Adicionar"

msgid "Address (%s is the searched text)"
msgstr "Endereço (%s é o texto buscado)"

msgid "Keyword"
msgstr "Atalho"

msgid "Keyword searches"
msgstr "Atalhos de busca"

msgid "New keyword search"
msgstr "Novo atalho de busca"

msgid "Remove"
msgstr "Remover"

msgid "Search %s for “%s”"
msgstr "Pesquisar em %s: “%s”"

msgid "Type the keyword before the text, for example: @y cats"
msgstr "Digite o atalho antes do texto, por exemplo: @y gatos"

msgid "Bookmark"
msgstr "Favorito"

msgid "Search browser bookmarks"
msgstr "Buscar nos favoritos do navegador"

msgid "Default browser only: Chrome, Chromium, Brave, Edge or Vivaldi"
msgstr "Só o navegador padrão: Chrome, Chromium, Brave, Edge ou Vivaldi"
